# Monad testnet
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadexplorer.com

# Optional: defaults to the Monad testnet deployment in src/lib/config.ts. Set these only for a local chain.
NEXT_PUBLIC_PAYROLL_ADDRESS=
NEXT_PUBLIC_FX_ADDRESS=
# Agora AUSD on Monad testnet
NEXT_PUBLIC_USD_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
NEXT_PUBLIC_AUSD_FAUCET_ADDRESS=0xd236c18D274E54FAccC3dd9DDA4b27965a73ee6C
NEXT_PUBLIC_FORWARDER_ADDRESS=

# Server only: funded key that pays fees for signed requests (the relayer). Never expose it.
RELAYER_PRIVATE_KEY=
# Optional server-side RPC (e.g. Alchemy Monad testnet); falls back to NEXT_PUBLIC_RPC_URL.
RELAYER_RPC_URL=
